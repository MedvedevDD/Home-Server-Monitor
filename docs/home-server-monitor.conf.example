# Home Server Monitor configuration

# Storage
HSM_STORAGE_HIDE_USB_FLASH=true
HSM_STORAGE_EXCLUDE_SERIALS=
HSM_STORAGE_EXCLUDE_MODELS=
HSM_CACHE_FILE=/var/cache/home-server-monitor/storage_inventory.json

# SMART
HSM_SMART_USE_SUDO=false
HSM_SMARTCTL_BINARY=smartctl

# MegaRAID / StorCLI
HSM_RAID_ENABLED=true
HSM_RAID_REQUIRED=false
HSM_RAID_STORCLI_ENABLED=true
HSM_STORCLI_USE_SUDO=false
HSM_STORCLI_BINARY=storcli
HSM_MEGARAID_CONTROL_DEVICE=
HSM_MEGARAID_CONTROL_DEVICES=

# HP Smart Array / ssacli
HSM_RAID_SSACLI_ENABLED=true
HSM_SSACLI_HELPER=/usr/local/libexec/hsm-hp-smartarray-helper
HSM_SSACLI_USE_SUDO=true

# 3ware
HSM_RAID_TWCLI_ENABLED=true
HSM_TWCLI_USE_SUDO=false
HSM_TWCLI_BINARY=tw_cli

# UPS / NUT
HSM_UPS_ENABLED=true
HSM_UPS_REQUIRED=false
HSM_UPS_NAME=ippon
HSM_UPSC_BINARY=upsc
HSM_UPS_BATTERY_EMPTY_VOLTAGE=42.0
HSM_UPS_BATTERY_FULL_VOLTAGE=54.4

# Grafana (leave empty for automatic detection)
HSM_GRAFANA_DATASOURCE_UID=

# Proxmox host collector
HSM_PROXMOX_ENABLED=true
HSM_PROXMOX_REQUIRED=false
HSM_PVEVERSION_BINARY=pveversion
HSM_PROXMOX_CPU_SAMPLE_SECONDS=0.10
# Cooling / x8fan
HSM_COOLING_ENABLED=true
HSM_COOLING_REQUIRED=false
HSM_COOLING_X8FAN_HELPER=/usr/local/libexec/hsm-x8fan-helper
HSM_COOLING_X8FAN_USE_SUDO=true
HSM_COOLING_X8FAN_TIMEOUT_SECONDS=5
HSM_COOLING_INFLUX_URL=http://127.0.0.1:8086/query
HSM_COOLING_INFLUX_DATABASE=raid
HSM_COOLING_INFLUX_TIMEOUT_SECONDS=3
HSM_COOLING_DISK_MAX_AGE_SECONDS=120
HSM_COOLING_CONTROL_STATE_FILE=/var/cache/home-server-monitor/cooling-control.json
HSM_COOLING_AUTO_REFRESH_SECONDS=300
