          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT mean(\"rpm\") FROM \"cooling_fan\" WHERE $timeFilter GROUP BY time($__interval), \"fan\" fill(null)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        }
      ],
      "title": "Fan RPM History",
      "type": "timeseries"
