        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT last(\"rpm\") AS \"rpm\", last(\"available\") AS \"available\" FROM \"cooling_fan\" WHERE $timeFilter GROUP BY \"fan\"",
