          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT mean(\"system_temp_c\") AS \"System\" FROM \"cooling_status\" WHERE $timeFilter AND \"system_temp_c\" > -100 GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT mean(\"hdd_input_c\") AS \"HDD Tmax\" FROM \"cooling_status\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
